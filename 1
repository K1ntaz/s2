<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Oil Pastel</title>
<style>
:root{color-scheme:dark;--bg:#000;--fg:#d8d4cf;--btn:#1d1d1d;--line:#3a3a3a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.4 system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:720px;margin:0 auto;padding:12px}
#stage{position:relative}
canvas{display:block;width:100%;height:auto;background:#080808;border-radius:6px}
#tip{position:absolute;display:none;border:2px solid #fff;border-radius:50%;pointer-events:none;transform:translate(-50%,-50%);box-sizing:border-box}
#bar{display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap}
#lab{flex:1;min-width:90px;opacity:.8}
button{background:var(--btn);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:8px 14px;font:inherit}
</style>
</head>
<body>
<main>
<div id="stage"><canvas id="c"></canvas><div id="tip"></div></div>
<div id="bar"><span id="lab">Загрузка…</span><button id="pp">Пауза</button><button id="sp">×1</button><button id="rs">Заново</button></div>
</main>
<script>
const DATA="data:image/jpeg;base64,";
const PASSES=[[40,1.15,2,.22,0,2],[24,.9,3,.14,70,4],[14,.85,3,.08,48,8],[9,.85,3,.04,36,16],[6,.9,3,.02,40,30],[4,1,2,.01,32,45]];
const PAPER='rgb(8,8,8)',TAU=6.2832;
const cv=document.getElementById('c'),ctx=cv.getContext('2d',{willReadFrequently:true});
const tip=document.getElementById('tip'),lab=document.getElementById('lab');
let W,H,src,gen,paused=false,speed=1,passIdx=0,raf,finished=false;
const R=(a,b)=>a+Math.random()*(b-a);
const cl=v=>v<0?0:v>255?255:v|0;
const cs=(c,j)=>`rgb(${cl(c[0]+j+R(-3,3))},${cl(c[1]+j+R(-3,3))},${cl(c[2]+j+R(-3,3))})`;

const img=new Image();
img.onload=()=>{
  const s=Math.min(1,720/img.width,1000/img.height);
  W=Math.round(img.width*s);H=Math.round(img.height*s);
  cv.width=W;cv.height=H;
  ctx.drawImage(img,0,0,W,H);
  src=ctx.getImageData(0,0,W,H).data;
  start();
};
img.src=DATA;

function start(){
  cancelAnimationFrame(raf);
  ctx.fillStyle=PAPER;ctx.fillRect(0,0,W,H);
  finished=false;paused=false;passIdx=0;
  document.getElementById('pp').textContent='Пауза';
  gen=run();raf=requestAnimationFrame(tick);
}

function boxBlur(a,rad){
  const t=new Float32Array(a.length),d=2*rad+1;
  for(let it=0;it<3;it++){
    for(let y=0;y<H;y++)for(let c=0;c<3;c++){
      const row=y*W;let sum=0;
      for(let i=-rad;i<=rad;i++)sum+=a[(row+Math.min(W-1,Math.max(0,i)))*3+c];
      for(let x=0;x<W;x++){
        t[(row+x)*3+c]=sum/d;
        sum+=a[(row+Math.min(W-1,x+rad+1))*3+c]-a[(row+Math.max(0,x-rad))*3+c];
      }
    }
    for(let x=0;x<W;x++)for(let c=0;c<3;c++){
      let sum=0;
      for(let i=-rad;i<=rad;i++)sum+=t[(Math.min(H-1,Math.max(0,i))*W+x)*3+c];
      for(let y=0;y<H;y++){
        a[(y*W+x)*3+c]=sum/d;
        sum+=t[(Math.min(H-1,y+rad+1)*W+x)*3+c]-t[(Math.max(0,y-rad)*W+x)*3+c];
      }
    }
  }
}

function* run(){
  for(let idx=0;idx<PASSES.length;idx++){
    passIdx=idx;
    const [brush,gridf,steps,dry,err]=PASSES[idx];
    const N=W*H,ref=new Float32Array(N*3),lum=new Float32Array(N);
    for(let p=0;p<N;p++){ref[p*3]=src[p*4];ref[p*3+1]=src[p*4+1];ref[p*3+2]=src[p*4+2];}
    boxBlur(ref,Math.max(1,Math.round(brush*.22)));
    const fine=new Float32Array(N*3),fl=Float32Array.from(ref);
    for(let p=0;p<N;p++){fine[p*3]=src[p*4];fine[p*3+1]=src[p*4+1];fine[p*3+2]=src[p*4+2];}
    boxBlur(fine,Math.max(1,Math.round(brush*.1)));
    boxBlur(fl,Math.max(1,Math.round(brush*.35)));
    for(let p=0;p<N;p++)lum[p]=.299*fl[p*3]+.587*fl[p*3+1]+.114*fl[p*3+2];
    const gx=new Float32Array(N),gy=new Float32Array(N);
    for(let y=0;y<H;y++)for(let x=0;x<W;x++){
      const p=y*W+x;
      gx[p]=(lum[y*W+Math.min(W-1,x+1)]-lum[y*W+Math.max(0,x-1)])/2;
      gy[p]=(lum[Math.min(H-1,y+1)*W+x]-lum[Math.max(0,y-1)*W+x])/2;
    }
    const cur=ctx.getImageData(0,0,W,H).data;
    const g=Math.max(2,(brush*gridf)|0),h=g>>1,pts=[];
    for(let y=h;y<H;y+=g)for(let x=h;x<W;x+=g){
      const px=Math.min(W-2,Math.max(1,x+Math.round(R(-g/3,g/3))));
      const py=Math.min(H-2,Math.max(1,y+Math.round(R(-g/3,g/3))));
      let s=0,n=0;
      for(let yy=Math.max(0,py-h);yy<=Math.min(H-1,py+h);yy++)for(let xx=Math.max(0,px-h);xx<=Math.min(W-1,px+h);xx++){
        const p=yy*W+xx;
        s+=Math.abs(cur[p*4]-ref[p*3])+Math.abs(cur[p*4+1]-ref[p*3+1])+Math.abs(cur[p*4+2]-ref[p*3+2]);n++;
      }
      if(s/n>err)pts.push([px,py]);
    }
    for(let i=pts.length-1;i>0;i--){const j=(Math.random()*(i+1))|0;[pts[i],pts[j]]=[pts[j],pts[i]];}
    for(const [px,py] of pts){
      const [path,col]=trace(px,py,brush,steps,ref,gx,gy);
      paint(path,col,brush,dry,fine);
      const e=path[path.length-1];
      yield [e[0],e[1],col,brush];
    }
  }
}

function trace(x,y,brush,steps,ref,gx,gy){
  const b0=((y|0)*W+(x|0))*3,base=[ref[b0],ref[b0+1],ref[b0+2]];
  const pts=[[x,y]];let lx=0,ly=0;const step=brush*.5;
  for(let i=0;i<steps;i++){
    const p=(y|0)*W+(x|0);
    if(i>1&&Math.abs(ref[p*3]-base[0])+Math.abs(ref[p*3+1]-base[1])+Math.abs(ref[p*3+2]-base[2])>60)break;
    const a=gx[p],b=gy[p],m=Math.hypot(a,b);let dx,dy;
    if(m<1e-3){
      if(!lx&&!ly){const q=R(0,TAU);dx=Math.cos(q);dy=Math.sin(q);}else{dx=lx;dy=ly;}
    }else{
      dx=-b/m;dy=a/m;
      if(!lx&&!ly){if(Math.random()<.5){dx=-dx;dy=-dy;}}
      else if(lx*dx+ly*dy<0){dx=-dx;dy=-dy;}
    }
    if(lx||ly){dx=.4*dx+.6*lx;dy=.4*dy+.6*ly;const n=Math.hypot(dx,dy)||1;dx/=n;dy/=n;}
    lx=dx;ly=dy;x+=dx*step;y+=dy*step;
    if(!(x>=1&&x<W-2&&y>=1&&y<H-2))break;
    pts.push([x,y]);
  }
  if(pts.length===1){const q=R(0,TAU);pts.push([x+Math.cos(q)*brush*.4,y+Math.sin(q)*brush*.4]);}
  return [pts,base.map(Math.round)];
}

function paint(pts,col,brush,dry,fine){
  const n0=pts.length,M=4*(n0-1)+1,P=[];
  for(let i=0;i<M;i++){
    const t=i*(n0-1)/(M-1),k=Math.min(n0-2,Math.floor(t)),f=t-k;
    P.push([pts[k][0]+(pts[k+1][0]-pts[k][0])*f,pts[k][1]+(pts[k+1][1]-pts[k][1])*f]);
  }
  const N=P.map((_,i)=>{
    const a=P[Math.max(0,i-1)],b=P[Math.min(M-1,i+1)];
    let tx=b[0]-a[0],ty=b[1]-a[1];const l=Math.hypot(tx,ty)||1;
    return [-ty/l,tx/l];
  });
  const half=brush/2;
  // 1) плоский мазок с рваным краем
  ctx.fillStyle=cs(col,0);ctx.beginPath();
  const ed=(i,sg)=>{
    const s_=i/Math.max(1,M-1),pf=Math.min(1,.55+Math.min(s_,1-s_)*5),r=half*pf*R(.85,1.12);
    return [P[i][0]+N[i][0]*r*sg,P[i][1]+N[i][1]*r*sg];
  };
  for(let i=0;i<M;i++){const q=ed(i,1);i?ctx.lineTo(q[0],q[1]):ctx.moveTo(q[0],q[1]);}
  for(let i=M-1;i>=0;i--){const q=ed(i,-1);ctx.lineTo(q[0],q[1]);}
  ctx.closePath();ctx.fill();
  // 2) щетинки
  const n=Math.max(3,(brush*.5)|0),w=Math.max(2,Math.round(brush/n*2.8));
  ctx.lineWidth=w;ctx.lineJoin='round';ctx.lineCap='round';
  for(let k=0;k<n;k++){
    const o=(k/(n-1)-.5)*brush*.85+R(-.6,.6),edge=Math.min(1,Math.abs(o)/half);
    const a=(M*.25*edge*edge*R(.3,1))|0,b=M-((M*.25*edge*edge*R(.3,1))|0);
    if(b-a<2)continue;
    const hl=Math.random(),lift=hl<.12?22:hl<.2?-18:0;
    for(let i=a;i<b-1;){
      const c=3+((Math.random()*5)|0);
      if(Math.random()>.12){
        const e=Math.min(b,i+c+1);
        const sx=Math.min(W-1,Math.max(0,(P[i][0]+N[i][0]*o)|0)),sy=Math.min(H-1,Math.max(0,(P[i][1]+N[i][1]*o)|0));
        const q=(sy*W+sx)*3,m=.4,j0=lift*.7+R(-3,3);
        ctx.strokeStyle=`rgb(${cl(col[0]*(1-m)+fine[q]*m+j0)},${cl(col[1]*(1-m)+fine[q+1]*m+j0)},${cl(col[2]*(1-m)+fine[q+2]*m+j0)})`;
        ctx.beginPath();
        for(let j=i;j<e;j++){
          const x=P[j][0]+N[j][0]*o,y=P[j][1]+N[j][1]*o;
          j===i?ctx.moveTo(x,y):ctx.lineTo(x,y);
        }
        ctx.stroke();
      }
      i+=c;
    }
  }
  // 3) сухая кисть: рваный край, видна чёрная бумага
  ctx.fillStyle=PAPER;ctx.beginPath();
  for(let k=0;k<((dry*brush*1.4)|0);k++){
    const i=(Math.random()*M)|0,o=(Math.random()<.5?-1:1)*half*Math.pow(R(.35,1),.7);
    const x=P[i][0]+N[i][0]*o,y=P[i][1]+N[i][1]*o,rx=R(.5,1.2+brush*.03),ry=R(.5,1.2+brush*.03);
    ctx.moveTo(x+rx,y);ctx.ellipse(x,y,rx,ry,0,0,TAU);
  }
  ctx.fill();
}

function fade(){
  finished=true;tip.style.display='none';lab.textContent='Последние штрихи…';
  const base=document.createElement('canvas');base.width=W;base.height=H;
  base.getContext('2d').drawImage(cv,0,0);
  let t=0;
  (function f(){
    t+=1/80;const k=Math.min(1,t);
    ctx.globalAlpha=1;ctx.drawImage(base,0,0);
    ctx.globalAlpha=k*k*(3-2*k);ctx.drawImage(img,0,0,W,H);ctx.globalAlpha=1;
    if(k<1)raf=requestAnimationFrame(f);else lab.textContent='Готово';
  })();
}
function tick(){
  if(!paused&&!finished){
    const n=PASSES[passIdx][5]*speed;let last=null;
    for(let k=0;k<n;k++){
      const r=gen.next();
      if(r.done){fade();return;}
      last=r.value;
    }
    if(last){
      const sc=cv.clientWidth/W,rad=Math.max(3,last[3]/2)*sc;
      tip.style.display='block';
      tip.style.left=last[0]*sc+'px';tip.style.top=last[1]*sc+'px';
      tip.style.width=tip.style.height=2*rad+'px';
      tip.style.background=`rgb(${last[2].join(',')})`;
    }
    lab.textContent='Слой '+(passIdx+1)+' из '+PASSES.length;
  }
  raf=requestAnimationFrame(tick);
}

document.getElementById('pp').onclick=e=>{paused=!paused;e.target.textContent=paused?'Дальше':'Пауза';};
document.getElementById('sp').onclick=e=>{speed=speed===1?2:speed===2?4:1;e.target.textContent='×'+speed;};
document.getElementById('rs').onclick=()=>{if(W)start();};
</script>
</body>
</html>
